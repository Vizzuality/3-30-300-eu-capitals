# 3-30-300 data processing. `just` lists the recipes.
#
# Variables can be set on the command line (`just release=2026-11 run stockholm`) or through the
# environment (TIPPECANOE_DIR, BUCKET, S3_ENDPOINT, AWS_PROFILE_NAME).

export KEDRO_DISABLE_TELEMETRY := "true"
export KEDRO_LOGGING_CONFIG := "conf/logging.yml"

release := "2026-10-stockholm"
tippecanoe_dir := env("TIPPECANOE_DIR", ".tools/bin")
bucket := env("BUCKET", "")
s3_endpoint := env("S3_ENDPOINT", "https://t3.storageapi.dev")
aws_profile := env("AWS_PROFILE_NAME", "3-30-300")

default:
    @just --list

# Run every pipeline for one capital: `just run stockholm` (writes data/03_primary/releases/<release>/)
[group('run')]
run capital:
    uv run kedro run --params "capital={{ capital }},release={{ release }},tippecanoe_dir={{ tippecanoe_dir }}"

# Run one pipeline for one capital: `just run-pipeline rule300 stockholm`
[group('run')]
run-pipeline pipeline capital:
    uv run kedro run --pipeline {{ pipeline }} --params "capital={{ capital }},release={{ release }},tippecanoe_dir={{ tippecanoe_dir }}"

# Run every capital whose boundary is pinned in conf/base/parameters/capitals.yml, then the cross-capital files
[group('run')]
run-all:
    #!/usr/bin/env bash
    set -euo pipefail
    capitals=$(uv run python -m data_processing.capitals --pinned)
    for c in $capitals; do
        echo "=== $c"
        just release={{ release }} run "$c"
    done
    last=$(echo "$capitals" | tail -n 1)
    uv run kedro run --pipeline release --params "capital=$last,release={{ release }}"

# Check a release folder: files, tile sizes against the budgets, attributes, known values for Stockholm
[group('release')]
check rel=release:
    uv run python -m data_processing.check {{ rel }}

# Print the content of an evidence tile, or of one building: `just inspect-evidence stockholm 15 18000 9500 [building id]`
[group('release')]
inspect-evidence capital z x y building="" rel=release:
    uv run python -m data_processing.inspect_evidence {{ rel }} {{ capital }} {{ z }} {{ x }} {{ y }} {{ building }}

# Upload a release to the bucket (refuses to overwrite an existing release). Needs BUCKET and the AWS profile.
[group('release')]
publish rel: (check rel)
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -z "{{ bucket }}" ]; then echo "Set BUCKET (the Railway bucket name)" >&2; exit 1; fi
    src="data/03_primary/releases/{{ rel }}"
    dest="s3://{{ bucket }}/releases/{{ rel }}"
    aws_s3() { aws s3 "$@" --endpoint-url "{{ s3_endpoint }}" --profile "{{ aws_profile }}"; }
    if [ -n "$(aws_s3 ls "$dest/" 2>/dev/null || true)" ]; then
        echo "$dest already exists: a release is never overwritten, publish under a new name" >&2
        exit 1
    fi
    aws_s3 sync "$src" "$dest" --exclude "*" --include "*.pmtiles" --content-type application/vnd.pmtiles --no-progress
    aws_s3 sync "$src" "$dest" --exclude "*" --include "*.json" --content-type application/json --no-progress
    echo "Published $dest. Set VITE_DATA_RELEASE={{ rel }} in Railway and redeploy to use it."

# Build felt/tippecanoe v2.82.0 from source into .tools/bin (needs git, make, a C++ compiler, sqlite3 and zlib headers)
[group('setup')]
install-tippecanoe:
    #!/usr/bin/env bash
    set -euo pipefail
    # v2.82.0 has no git tag: it is this commit of main (version.hpp says v2.82.0)
    commit=4f2621186acfec33b63ddf636f665623c0fef2dd
    tmp=$(mktemp -d)
    git -C "$tmp" init -q tippecanoe
    git -C "$tmp/tippecanoe" fetch -q --depth 1 https://github.com/felt/tippecanoe.git "$commit"
    git -C "$tmp/tippecanoe" checkout -q FETCH_HEAD
    make -C "$tmp/tippecanoe" -j
    mkdir -p .tools/bin
    cp "$tmp/tippecanoe/tippecanoe" "$tmp/tippecanoe/tippecanoe-decode" "$tmp/tippecanoe/tile-join" .tools/bin/
    rm -rf "$tmp"
    .tools/bin/tippecanoe --version

# Run the tests (as in CI)
[group('dev')]
test:
    uv run pytest

# Lint and check formatting (as in CI)
[group('dev')]
lint:
    uv run ruff check .
    uv run ruff format --check .
